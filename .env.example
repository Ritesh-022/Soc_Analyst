# Ascense environment configuration.
# Copy to .env and adjust values for your environment.
# Never commit real secrets to the repository.

# Core
ASCENSE_ENV=development
ASCENSE_DEBUG=true
LOG_LEVEL=INFO

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://ascense:ascense_dev_password@localhost:5432/ascense

# Message broker (RabbitMQ)
RABBITMQ_URL=amqp://ascense:ascense_dev_password@localhost:5672/

# Cache (Redis)
REDIS_URL=redis://localhost:6379/0

# Object storage (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=ascense
S3_SECRET_KEY=ascense_dev_password
S3_BUCKET_EVIDENCE=ascense-evidence

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=ascense-platform

# Authentication (OIDC)
JWT_ISSUER=https://auth.ascense.example
JWT_AUDIENCE=ascense-api
# In development, use a shared secret for testing
DEV_AUTH_SECRET=dev-secret-change-me

# Gateway mTLS
GATEWAY_CA_CERT=

# Frontend
VITE_API_BASE=http://localhost:8000

# CORS — comma-separated list of allowed origins
ASCENSE_CORS_ORIGINS=http://localhost:5173

# Run background workers (detection, correlation, normalization) inside the API process
# Set to "false" to run workers as separate processes instead
ASCENSE_RUN_WORKERS=true
