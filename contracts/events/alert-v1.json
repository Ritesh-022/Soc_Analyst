{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ascense.example/contracts/events/alert-v1.json",
  "title": "Alert v1",
  "description": "Actionable correlated finding promoted by the correlation service.",
  "type": "object",
  "required": [
    "alert_id",
    "tenant_id",
    "alert_type",
    "severity",
    "risk_score",
    "status",
    "observed_at",
    "created_at"
  ],
  "additionalProperties": false,
  "properties": {
    "alert_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "incident_id": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "alert_type": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "risk_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "status": {
      "type": "string",
      "enum": [
        "NEW",
        "ACKNOWLEDGED",
        "UNDER_INVESTIGATION",
        "RESOLVED",
        "FALSE_POSITIVE"
      ]
    },
    "detection_finding_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "event_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "description": "References to retrievable, authorized evidence records"
    },
    "affected_asset_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "summary": {
      "type": "string"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}