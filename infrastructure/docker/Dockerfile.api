# Dockerfile for the Ascense Platform API.
# Build: docker build -f infrastructure/docker/Dockerfile.api -t ascense-api .
# Run: docker run -p 8000:8000 ascense-api

FROM python:3.12-slim AS base

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY pyproject.toml ./
RUN pip install --no-cache-dir -e ".[dev]"

# Copy application code
COPY ascense/ ./ascense/
COPY contracts/ ./contracts/
COPY database/ ./database/
COPY alembic.ini ./

EXPOSE 8000

CMD ["uvicorn", "ascense.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
